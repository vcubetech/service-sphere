generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OWNER
  ANALYST
}
enum MonitoringStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}
enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}
enum ChangeSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}
enum AlertType {
  LAND_COVER_CHANGE
  VEGETATION_LOSS
  WATER_CHANGE
  BUILT_UP_CHANGE
  CUSTOM
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  properties   Property[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Property {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  /// Land-record survey number; required by the API, nullable for properties created before it existed.
  surveyNumber String?
  description String?
  areaHectares Float?
  boundary    Json?
  centroidLat Float?
  centroidLng Float?
  address     String?
  isActive    Boolean  @default(true)
  jobs        MonitoringJob[]
  changes     LandChange[]
  alerts      Alert[]
  reports     MonitoringReport[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([ownerId])
  @@unique([ownerId, surveyNumber])
}

model MonitoringJob {
  id              String @id @default(uuid()) @db.Uuid
  propertyId      String @db.Uuid
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requestedById   String? @db.Uuid
  status          JobStatus @default(QUEUED)
  startDate       DateTime
  endDate         DateTime
  cloudMaxPercent Float @default(20)
  collection      String @default("COPERNICUS/S2_SR_HARMONIZED")
  result          Json?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([propertyId, createdAt])
}

model LandChange {
  id              String @id @default(uuid()) @db.Uuid
  propertyId      String @db.Uuid
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  monitoringJobId String? @db.Uuid
  changeType      String
  severity        ChangeSeverity @default(MEDIUM)
  confidence      Float?
  areaHectares    Float?
  detectedAt      DateTime @default(now())
  beforeImageDate DateTime?
  afterImageDate  DateTime?
  beforeImageUrl  String?
  afterImageUrl   String?
  geometry        Json?
  description     String?
  createdAt       DateTime @default(now())
  @@index([propertyId, detectedAt])
}

model Alert {
  id          String @id @default(uuid()) @db.Uuid
  propertyId  String @db.Uuid
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type        AlertType @default(LAND_COVER_CHANGE)
  severity    ChangeSeverity @default(MEDIUM)
  status      AlertStatus @default(OPEN)
  title       String
  message     String
  metadata    Json?
  acknowledgedAt DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([propertyId, status, createdAt])
}

model MonitoringReport {
  id          String @id @default(uuid()) @db.Uuid
  propertyId  String @db.Uuid
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title       String
  periodStart DateTime
  periodEnd   DateTime
  summary     String
  metrics     Json?
  fileUrl     String?
  generatedAt DateTime @default(now())
  @@index([propertyId, generatedAt])
}

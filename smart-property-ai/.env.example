# ---- Server ----
PORT=4000
NODE_ENV=development
UPLOAD_DIR=./data/uploads

# ---- PostgreSQL + PostGIS + pgvector ----
DATABASE_URL="postgresql://spm:spm_password@localhost:5432/smart_property?schema=public"

# ---- LLM (OpenAI-compatible) ----
# Works with OpenAI, Azure OpenAI, or any OpenAI-compatible endpoint (Ollama, vLLM, Groq...)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Change detection tuning ----
CHANGE_PIXEL_THRESHOLD=40
CHANGE_MIN_AREA_PX=60
CHANGE_ANALYSIS_WIDTH=1024

# ---- Scheduler: re-scan all properties (cron syntax). Empty = disabled ----
MONITOR_CRON="0 2 * * *"

# ---- Optional: alert webhook (Slack/Teams/any JSON endpoint) ----
ALERT_WEBHOOK_URL=

    {
      "name": "Tax Returns",
      "item": [
        {
          "name": "List active financial years",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tax-returns/financial-years",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "description": "Stores the first returned financial-year id in financialYearId.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rows = pm.response.json(); if (pm.response.code === 200 && rows.length) { pm.collectionVariables.set('financialYearId', rows[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List tax returns",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tax-returns?page=1&limit=20",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "description": "Optional query parameters: page (default 1), limit (default 20, max 100)."
        },
        {
          "name": "Create tax return",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tax-returns",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"financialYearId\": \"{{financialYearId}}\",\n  \"itrForm\": \"ITR_3\",\n  \"filingType\": \"ORIGINAL\",\n  \"taxRegime\": \"NEW_REGIME\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Creates a draft return for the authenticated customer and saves its id to taxReturnId.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('taxReturnId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get tax return details",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tax-returns/{{taxReturnId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "description": "Returns return details, income, deductions, documents, audit assignment, and filing history."
        },
        {
          "name": "Update draft tax return",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tax-returns/{{taxReturnId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itrForm\": \"ITR_3\",\n  \"filingType\": \"ORIGINAL\",\n  \"taxRegime\": \"NEW_REGIME\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Only draft and query-raised returns can be updated by the customer."
        },
        {
          "name": "Submit tax return",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/tax-returns/{{taxReturnId}}/submit",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "description": "Submits an editable customer return for review. No request body is required."
        },
        {
          "name": "Add income detail",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tax-returns/{{taxReturnId}}/income",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"incomeType\": \"SALARY\",\n  \"description\": \"Annual salary income\",\n  \"employerName\": \"ABC Technologies Pvt Ltd\",\n  \"grossAmount\": 600000,\n  \"taxableAmount\": 600000,\n  \"tdsAmount\": 45000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Add deduction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tax-returns/{{taxReturnId}}/deductions",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"section\": \"80C\",\n  \"description\": \"Eligible investment declaration\",\n  \"amount\": 50000,\n  \"eligibleAmount\": 50000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "eligibleAmount must not exceed amount."
        },
        {
          "name": "Save tax computation",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tax-returns/{{taxReturnId}}/computation",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auditorToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grossTotalIncome\": 1250000,\n  \"exemptIncome\": 0,\n  \"deductions\": 75000,\n  \"taxableIncome\": 1175000,\n  \"basicTax\": 96154,\n  \"surcharge\": 0,\n  \"cess\": 3846,\n  \"rebate\": 0,\n  \"tds\": 50000,\n  \"advanceTax\": 30000,\n  \"selfAssessmentTax\": 15000,\n  \"finalTax\": 15000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Requires the assigned auditor or an admin. All computation amounts are required and non-negative."
        },
        {
          "name": "Update tax return filing status (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tax-returns/{{taxReturnId}}/status",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"READY_TO_FILE\",\n  \"remarks\": \"Ready for filing\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Status transitions are enforced. acknowledgementNumber is required when status is FILED."
        }
      ],
      "description": "List requests support page and limit query parameters. IDs use collection variables."
    },

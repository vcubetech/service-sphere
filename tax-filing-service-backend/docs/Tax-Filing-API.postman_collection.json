        {
          "name": "List audit assignments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/audits/assignments",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auditorToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Create audit assignment (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/audits/assignments",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taxReturnId\": \"{{taxReturnId}}\",\n  \"auditorId\": \"{{auditorId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Return must be submitted and the auditor must be verified and available. Saves assignment id to assignmentId.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('assignmentId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Update audit assignment status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/audits/assignments/{{assignmentId}}/status",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auditorToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {

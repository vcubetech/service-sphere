{
  "info": {
    "name": "Tax Filing API",
    "description": "Requests for every endpoint documented in docs/API_DOCUMENTATION.md. Set baseUrl and log in with the appropriate demo account to populate the token variables. Financial-year, return, auditor, assignment, finding, document, and payment IDs can be set from responses or entered manually.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{customerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "apiServerUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "auditorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "financialYearId",
      "value": "",
      "type": "string"
    },
    {
      "key": "taxReturnId",
      "value": "",
      "type": "string"
    },
    {
      "key": "auditorId",
      "value": "",
      "type": "string"
    },
    {
      "key": "assignmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "findingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "documentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check (API base path)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          },
          "description": "GET /api/health. Returns { status, service }."
        },
        {
          "name": "Health check (legacy path)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiServerUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          },
          "description": "Legacy GET /health path."
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Customer\",\n  \"email\": \"postman.customer+{{$timestamp}}@example.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"Demo@12345\",\n  \"role\": \"CUSTOMER\",\n  \"panNumber\": \"FGHIJ5678K\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Creates a customer account. Use a unique PAN/email if repeating this request."
        },
        {
          "name": "Register auditor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Auditor\",\n  \"email\": \"postman.auditor+{{$timestamp}}@example.com\",\n  \"phone\": \"9876543211\",\n  \"password\": \"Demo@12345\",\n  \"role\": \"AUDITOR\",\n  \"membershipNumber\": \"POSTMAN-CA-001\",\n  \"firmName\": \"Postman Tax Associates\",\n  \"qualification\": \"Chartered Accountant\",\n  \"experienceYears\": 5,\n  \"city\": \"Coimbatore\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Creates an auditor account. Auditor status is initially pending."
        },
        {
          "name": "Login customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@demo.com\",\n  \"password\": \"Demo@12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Signs in the seeded customer and stores the JWT in customerToken.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('customerToken', pm.response.json().token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login auditor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"auditor@demo.com\",\n  \"password\": \"Demo@12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Signs in the seeded auditor and stores the JWT in auditorToken.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('auditorToken', pm.response.json().token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@demo.com\",\n  \"password\": \"Demo@12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Signs in the seeded admin and stores the JWT in adminToken.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('adminToken', pm.response.json().token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "description": "Returns the authenticated user and customer/auditor profile."
        }
      ],
      "description": "Demo logins use the seeded accounts when available. Login requests save JWTs to the corresponding collection variables."
    },
